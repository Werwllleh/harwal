mixin modalConsultation()

    //modal-consultation
    .modal-consultation-inner&attributes(attributes)
        .modal-consultation-inner__body
            .modal-consultation-inner__top
                p.modal-consultation-inner__title Ответим на любой вопрос
                p.modal-consultation-inner__text Обсудим задачи, найдем оптимальное решение и&nbsp;запланируем работы. Будем на связи!
                .modal-consultation-inner__form
                    +form("modal")
            .modal-consultation-inner__bottom
                .modal-consultation-inner__bottom--inner
                    p Или звоните нам, мы&nbsp;работаем с&nbsp;понедельника по&nbsp;пятницу, с&nbsp;9:00 до&nbsp;18:00
                    a(href="tel:+74954090050") +7 (495) 409-00-50

