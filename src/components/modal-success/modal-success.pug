mixin modalSuccess()

    //modal-success
    .modal-success-inner&attributes(attributes)
        .modal-success-inner__body
            p.modal-success-inner__title Спасибо, форма успешно отправлена
            p.modal-success-inner__text Менеджер свяжется с вами в ближайшее время
            button(type="button").btn.primary.modal-success-inner__close.modal--close Закрыть
