mixin subsections(list)

    //subsections
    .subsections&attributes(attributes)
        .subsections__container.container
            .subsections__body
                .subsections__title
                    p.h4 Подразделы
                if list && list.length
                    ul.subsections__list
                      each item in list
                          li
                              button(type="button", data-subsection=item.value)
                                  =item.title
                                  span
                                      +svg("arrow-right-link")
