mixin sliderPhotos(images, slideWidth, title)

    //slider-photos
    .slider-photos(class=`w${slideWidth}`)&attributes(attributes)
        .slider-photos__body
            if title
                .slider-photos__title
                    .container
                        p.h4= title
            if images && images.length
                .slider-photos__swiper.swiper
                    .swiper-wrapper(data-lightgallery)
                        each source in images
                          .swiper-slide(data-src=source)
                              .slider-photos__card
                                  a(href=source)
                                      img(src=source, alt="")
