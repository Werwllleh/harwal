mixin header()

    //header
    header.header&attributes(attributes)
        .header__container.container
            .header__body
                a(href="./").header__logo
                    +svg("harwal-logo")
                nav.header-nav
                    ul.header-nav__list
                        li.header-nav__list--item
                            a(href="./main.html").header-nav__list--link Главная
                        li.header-nav__list--item
                            a(href="./products.html").header-nav__list--link Продукция
                            ul.header-nav__sublist
                                li
                                    a(href="./products3.html") Обработка стекла
                                li
                                    a(href="./products4.html") Алюминиевые светопрозрачные конструкции
                        li.header-nav__list--item
                            a(href="./projects.html").header-nav__list--link Проекты
                        li.header-nav__list--item
                            a(href="./services.html").header-nav__list--link Услуги
                        li.header-nav__list--item
                            a(href="./about-company.html").header-nav__list--link О нас
                            ul.header-nav__sublist
                                li
                                    a(href="./quality-policy.html") Политика качества
                                li
                                    a(href="./production.html") Производство
                        li.header-nav__list--item
                            a(href="./contacts.html").header-nav__list--link Контакты
                .header__info
                    .header-contacts
                        .header-contacts__preview
                            a(href="tel:+74954090050").header-contacts__preview--phone
                                span
                                | +7 (495) 409-00-50
