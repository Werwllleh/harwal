                                                li
                                                    span Главный офис и завод
                                                    a(href="https://yandex.ru/maps/-/CLhBEVjJ" target="_blank" rel="noopener noreferrer") Московская область, Солнечногорск, Бутырский тупик, 2а
                                                li
                                                    span Телефон
                                                    a(href="tel:+74954090050") +7 (495) 409-00-50
                                                li
                                                    span Email
                                                    a(href="mailto:info@harwal.ru") info@harwal.ru
                                    li.header-contacts__detail--item
                                        .header-contacts__detail--address
                                            ul
                                                li
                                                    span Московский офис
                                                    a(href="https://yandex.ru/maps/-/CLhBIR89" target="_blank" rel="noopener noreferrer") Москва, Шарикоподшипниковская, д1 ,БЦ «Прогресс Плаза»
                                                li
                                                    span Телефон
                                                    a(href="tel:+74950551333") +7 (495) 055-13-33
                                                li
                                                    span Email
                                                    a(href="mailto:info@harwal.ru") info@harwal.ru


                    button(type="button", data-modal="consultation").btn.transparent.header__button-request Оставить заявку
                button.header__burger
