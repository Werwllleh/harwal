extends ../../app/pug/layouts/secondary.pug

append vars
  - title = "Услуга детальная"
  - description = "Описание страницы услуга детальная"

append content

    .page__header
        .page__breadcrumbs
            .container
                +breadcrumbs(['Главная', 'Услуги', 'Проектирование'])
        .page__title
            .container
                p Услуги
        .page__header--bg
            img(src="./images/header-bg.webp", alt="")
    .page__content
        .service-detail
            .service-detail__title
                .container
                    h1.h1 Проектирование
            figure.figure
                img(src="./images/photo7.webp", alt="Резка и обработка кромки")
                .figure__info
                    .figure__info--container.container
                        ul.advantages
                            li
                                span
                                    +svg("check2")
                                p Высокая квалификация инженеров
                            li
                                span
                                    +svg("check2")
                                p Высокая скорость работы
                            li
                                span
                                    +svg("check2")
                                p Гарантия требований и&nbsp;стандартов
            +interestedForm(2)
            .textblock
                .container
                    .textblock__body
                        p.h4.textblock__title Ha&nbsp;заводе вы&nbsp;можете заказать проектирование любых светопрозрачных конструкций, от&nbsp;остекленных фасадов до&nbsp;балконных и&nbsp;лестничных ограждений.
                        .textblock__text
                            p Мы&nbsp;соблюдаем условия договоров&sbquo; что позволяет клиентам получать грамотный, без ошибок и&nbsp;недочетов проект в&nbsp;оговоренные сроки.
            +subsections([
              {
                title: "Параметры продукции",
                value: "params"
              },
              {
                title: "Фотогалерея",
                value: "photos"
              },
              {
                title: "Вопрос-ответ",
                value: "qa"
              },
              {
                title: "Наши клиенты",
                value: "clients"
              },
              {
                title: "Преимущества",
                value: "advantages"
              },
              {
                title: "Описание продукта",
                value: "description"
              },
              {
                title: "Благодарственные письма",
                value: "thanks-letters"
              },
              {
                title: "Обратная связь",
                value: "feedback"
              }
            ])
            .service-detail-price(data-section="params")
                .service-detail-price__container.container
                    .service-detail-price__body
                        p.h4.service-detail-price__title Цены за услугу проектирования
                        ul.service-detail-price__list
                            li
                                p Название услуги
                                span 1000р/п.м.
                            li
                                p Название услуги
                                span 1000р/п.м.
                            li
                                p Название услуги
                                span 1000р/п.м.
                            li
                                p Название услуги
                                span 1000р/п.м.
            .information(data-section="description")
                .information__container.container
                    .information__body
                        .information__left
                            .information-textblock
                                p.h4.information-textblock__title Резка
                                .information-textblock__text
                                    p Промышленная нарезка стекла выполняется по&nbsp;необходимым размерам, формам, эскизам и&nbsp;чертежам. Применяются станки с&nbsp;числовым программным управлением&nbsp;&mdash; ЧПУ.
                                    p Это высокоточное оборудование позволяет выполнять качественную нарезку стекла, предотвращая появление сколов и&nbsp;трещин на&nbsp;кромке стекла.
                                    p Изготовление любого стеклоизделия начинается с&nbsp;резки и&nbsp;обработки кромки. Обработка кромки стекла в&nbsp;свою очередь, обеспечивает безопасность последующей работы со&nbsp;стеклом и&nbsp;защищает от&nbsp;возможных порезов, придает изделию привлекательный внешний вид.
                            .information-textblock
                                p.h4.information-textblock__title Обработка кромки
                                .information-textblock__text
                                    p Доступны различные виды обработки кромки, которая обеспечивает безопасность последующей работы со&nbsp;стеклом и&nbsp;защищает от&nbsp;возможных порезов, придает изделию привлекательный внешний вид.
                                .information-list
                                    p.information-list__title Виды обработки кромки:
                                    ul
                                        li
                                            span
                                                +svg("check2")
                                            p Шлифовка&nbsp;&mdash; удаления острых углов, торцы становятся матовыми и&nbsp;шероховатыми.
                                        li
                                            span
                                                +svg("check2")
                                            p Полировка&nbsp;&mdash; придание торцовой части прозрачности и&nbsp;гладкости.
                                        li
                                            span
                                                +svg("check2")
                                            p Фацет&nbsp;&mdash; полировка, скошенная к&nbsp;краю под определенным углом.
                            .information-textblock
                                p.h4.information-textblock__title Оборудование
                                .information-textblock__text
                                    p Большие производственные мощности позволяют нам за&nbsp;короткое время выполнять крупные заказы по&nbsp;обработке, декорированную и&nbsp;изготовлению всевозможных изделий из&nbsp;стекла.
                                button(type="button", data-modal="consultation").btn.primary Подробнее про&nbsp;оборудование
                        .information__right
                            +docCard("Презентация Harwal", "В презентации вы можете ознакомиться с более подробным описанием продукции и услуг, узнать про нашу компанию, оборудование и сертификаты.", "(9,7 Мб, pdf)")
                            button(type="button", data-modal="consultation").btn.primary Задать вопрос
            .service-detail-qa(data-section="qa")
                +questionAnswer()
            .service-detail-photos(data-section="photos")
                +sliderPhotos(["./images/production/1.webp", "./images/production/2.webp", "./images/production/3.webp", "./images/production/4.webp", "./images/production/5.webp", "./images/production/1.webp", "./images/production/2.webp", "./images/production/3.webp", "./images/production/4.webp", "./images/production/5.webp"], 442, "Фото галерея")
            .service-detail-adv(data-section="advantages")
                .container
                    .service-detail-adv__title
                        p.h4 Преимущества продукта
                    ul.adv-list
                        li
                            .adv-card
                                img(src="./images/become-partner/bp-4.webp", alt="")
                                p
                                    | Годовая конверсионная мощность 200&nbsp;000 метрических тонн пластика и&nbsp;20&nbsp;000 тонн алюминия и&nbsp;стали
                        li
                            .adv-card
                                img(src="./images/become-partner/bp-4.webp", alt="")
                                p
                                    | Годовая конверсионная мощность 200&nbsp;000 метрических тонн пластика и&nbsp;20&nbsp;000 тонн алюминия и&nbsp;стали
                        li
                            .adv-card
                                img(src="./images/become-partner/bp-4.webp", alt="")
                                p
                                    | Годовая конверсионная мощность 200&nbsp;000 метрических тонн пластика и&nbsp;20&nbsp;000 тонн алюминия и&nbsp;стали
            .service-detail-letters(data-section="thanks-letters")
                +thanksLetters("Благодарственные письма")
            .service-detail-companies(data-section="clients")
                .companies
                    .companies__container.container
                        .companies__body
                            h4.h4.companies__title
                                | Клиенты компании
                                |
                                span Harwal Enterprises
                            ul.companies__list
                                li
                                    img(src="./images/companies/tamglass.webp", alt="")
                                li
                                    img(src="./images/companies/alutech.webp", alt="")
                                li
                                    img(src="./images/companies/bavelloni.webp", alt="")
                                li
                                    img(src="./images/companies/elumatec.webp", alt="")
                                li
                                    img(src="./images/companies/salavatsteklo.webp", alt="")
                                li
                                    img(src="./images/companies/fapim.webp", alt="")
                                li
                                    img(src="./images/companies/keraglass.webp", alt="")
                                li
                                    img(src="./images/companies/fenzi.webp", alt="")
                                li
                                    img(src="./images/companies/bystronic.webp", alt="")
                                li
                                    img(src="./images/companies/schuco.webp", alt="")
                                li
                                    img(src="./images/companies/realit.webp", alt="")
                                li
                                    img(src="./images/companies/guardian-glass.webp", alt="")
                                li
                                    img(src="./images/companies/agc.webp", alt="")
                                li
                                    img(src="./images/companies/pilkington.webp", alt="")
                                li
                                    img(src="./images/companies/sial.webp", alt="")
            .service-detail-banner-form(data-section="feedback")
                +bannerForm(1)
