extends ../../app/pug/layouts/secondary.pug

append vars
  - title = "Products"
  - description = "Описание Products"

append content

    .page__header
        .page__breadcrumbs
            .container
                +breadcrumbs(['Главная', 'Продукция'])
        .page__title
            .container
                p Продукция
        .page__header--bg
            img(src="./images/header-bg.webp", alt="")
    .page__content
        .page-products
            .container
                nav.list-links
                    ul
                        li
                            a(href="./products3.html")
                                | Обработка стекла
                                +svg("arrow-right-link")
                        li
                            a(href="./products4.html")
                                | Алюминиевые светопрозрачные конструкции
                                +svg("arrow-right-link")
                        li
                            a(href="./products5.html")
                                | Огнестойкие панели
                                +svg("arrow-right-link")
                        li
                            a(href="./products6.html")
                                | Металлические конструкции
                                +svg("arrow-right-link")
