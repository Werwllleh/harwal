extends ../../app/pug/layouts/secondary.pug

append vars
  - title = "Products2"
  - description = "Описание Products2"

append content

    .page__header
        .page__breadcrumbs
            .container
                +breadcrumbs(['Главная', 'Продукция', 'Обработка стекла'])
        .page__title
            .container
                p Продукция
        .page__header--bg
            img(src="./images/header-bg.webp", alt="")
