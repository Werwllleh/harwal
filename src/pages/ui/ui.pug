extends ../../app/pug/layouts/base.pug

append vars
  - title = "Ui"
  - description = "Описание Ui"

append content

    .page-ui
        .page-ui__elements
            button(type="button", data-modal="consultation").btn.primary Открыть модалку
            button(type="button", data-modal="success").btn.primary Модалка успех
            button(type="button").btn.secondary Оставить заявку
            button(type="button").btn.transparent Оставить заявку
            button(type="button").btn.light Государственные
            +checkbox()
            +buttonInfo()
            +buttonInfo()
            +productCard('Алюминиевые оконные системы', '1.webp')
            +projectCard('Жилой комплекс Лефорт', '1.webp', true)
            +projectCard('Жилой комплекс ILOVE', '2.webp')
            +newsCard('Смотрите новую видео-презентацию завода Нarwal Enterprise', '1.webp')
            +bannerForm(1)
            +bannerForm(2)
            +formLead("Параметры продукции", [
              {
                type: '',
                input: 'radio',
                name: 'profile-type',
                question: 'Вид алюминиевого профиля',
                answers: [
                  {
                    text: "Круглый",
                    image: "./images/form-image.jpg",
                    color: "",
                  },
                  {
                    text: "Овальный",
                    image: "./images/form-image.jpg",
                    color: "",
                  },
                  {
                    text: "Квадрат",
                    image: "./images/form-image.jpg",
                    color: "",
                  }
                ]
              },
              {
                type: 'color',
                input: 'checkbox',
                name: 'profile-color',
                question: 'Цвет алюминиевого профиля',
                answers: [
                  {
                    text: "Белый",
                    image: "",
                    color: "#fff",
                  },
                  {
                    text: "Черный",
                    image: "",
                    color: "#2C3138",
                  },
                  {
                    text: "Красный",
                    image: "",
                    color: "#ff0c0c",
                  },
                  {
                    text: "Желтый",
                    image: "",
                    color: "#f7db3f",
                  },
                  {
                    text: "Зеленый",
                    image: "",
                    color: "#1fc71f",
                  },
                  {
                    text: "Серый",
