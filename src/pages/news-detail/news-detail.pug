extends ../../app/pug/layouts/secondary.pug

append vars
  - title = "News-detail"
  - description = "Описание News-detail"

append content

    .page__header
        .page__breadcrumbs
            .container
                +breadcrumbs(['Главная', 'Новости', 'Результаты 27-й международной выставки KAZBUILD 2021'])
        .page__title
            .container
                p 15 октября 2021
        .page__header--bg
            img(src="./images/header-bg.webp", alt="")
    .page__content
        .news-detail
            .news-detail__title
                .container
                    h1.h1 Результаты 27-й международной выставки KAZBUILD 2021
            figure.figure
                img(src="./images/photo3.webp", alt="Завод Harwal Enterprises")
                .figure__info
                    .figure__info--container.container
                        ul.article-info
                            li
                                span
                                    +svg("clock")
                                p 15 октября 2021 (обновлено: 17 октября 2021)
                            li
                                span
                                    +svg("eye")
                                p 3048
                            li
                                span
                                    +svg("clock2")
                                p Время прочтения: 5 минут
            .news-detail-textblock
                .news-detail-textblock__container.container
                    .news-detail-textblock__body
                        .news-detail-textblock__title
                            p.h4 В&nbsp;начале сентября (с&nbsp;7&nbsp;по&nbsp;9&nbsp;сентября) в&nbsp;Казахстане прошло крупнейшее строительное событие этого года&nbsp;&mdash; 27-ая международная выставка KAZBUILD 2021, в&nbsp;г. Алматы
                        .news-detail-textblock__text
                            p Наша компания ООО «Харвал Энтерпрайзис» приняла участие в этом грандиозном событии по приглашению Фонда поддержки ВЭД Московской области. С первого дня выставки, стенд нашей компании вызвал большой интерес у посетителей. За 3 дня выставки его посетили более 200 человек, более 50 человек проявили интерес к продукции ООО «Харвал Энтерпрайзис», среди них архитекторы, строительные компании, проектные бюро, частные клиенты.
                            p По мимо продукции нашей компании, большой интерес был к алюминиевым профильным системам, которые мы перерабатываем на нашем производстве, но которые не представлены на территории Казахстана. В ходе общения с посетителями, стало понятно, что на рынке Казахстана знают профильные системы Reunaers, Schuco, Алютех. Так же на рынке присутствуют малоизвестные профиля местного производства, типа ALPROF. По подсчётам нашего партнера, поставщика профильной системы Reunaers, на 3 стройки в Алмате приходится 10 строек в Астане. Рынок Казахстана нуждается в нашей продукции – алюминиевых светопрозрачных конструкциях и стеклопакетах.
                            p Посетив все стенды выставки, был выявлен ещё один производитель стеклопакетов, компания ТОО «АГРАН» (г. Уральск, Казахстан). По заявлению представителя этой компании, они сильно уступают нам по техническим возможностям своего производства и соответственно, по ассортименту выпускаемой продукции. По алюминиевым конструкциям было представлено ещё две компании. 1. Конструкции с безрамным остеклением, компания АССАНОВ Групп (г. Алматы, Казахстан). 2. Ограждения уличных бассейнов, зимних садов, беседок, компания MontAlu, (Словакия). Изучив продукцию этих компаний, можно заключить, что конкурентов нам на этой выставке не было, что позволило привлечь максимум внимания посетителей к нашей компании.
                            p Участие в выставке, позволило получить контакты потенциальных клиентов на рынке Казахстана, понять ситуацию на строительном рынке страны, выявить спрос на выпускаемую нами продукцию. Для нашей компании выставка прошла успешно, что подтверждает обратная связь от посетителей нашего стенда и первые запросы на просчёт.
                            p С Фондом поддержки ВЭД Московской области достигнута договорённость о дальнейшем сотрудничестве, информировании о выставках, мероприятиях, мерах поддержки со стороны фонда и государства.
            .article-services
                .article-services__container.container
                    p.h4.article-services__title
                        | Harwal Enterprises предлагает полный спектр услуг от&nbsp;проектирования до&nbsp;монтажа:
                    .article-services__items
                        ul
                            li
                                span
                                    +svg("pencil")
                                p Проектирования изделия
                            li
                                span
                                    +svg("pencil")
                                p Производство
                            li
                                span
                                    +svg("pencil")
                                p Удобная логистика (быстрая доставка изделий)
            .news-detail-photos
                +sliderPhotos(["./images/production/1.webp", "./images/production/2.webp", "./images/production/3.webp", "./images/production/4.webp", "./images/production/5.webp", "./images/production/1.webp", "./images/production/2.webp", "./images/production/3.webp", "./images/production/4.webp", "./images/production/5.webp"], 422, 'Фото галерея')
