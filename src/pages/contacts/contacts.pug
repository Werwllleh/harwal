extends ../../app/pug/layouts/secondary.pug

append vars
  - title = "Contacts"
  - description = "Описание Contacts"

append content

    .page__header
        .page__breadcrumbs
            .container
                +breadcrumbs(['Главная', 'Контакты'])
        .page__title
            .container
                p Контакты
        .page__header--bg
            img(src="./images/header-bg.webp", alt="")
    .page__content
        .page-contacts
            section.page-contacts-title
                .container
                    h1.h1 Россия
            section.contacts-addresses
                .contacts-addresses__container.container
                    .contacts-addresses__items
                        .contacts-addresses__item
                            ul
                                li
                                    span Главный офис и завод
                                    a(href="https://yandex.ru/maps/-/CLhBEVjJ", target="_blank", rel="noreferrer noopener") Московская область, Солнечногорск, Бутырский тупик, 2а
                                li
                                    span Телефон
                                    a(href="tel:+74954090050") +7 (495) 409-00-50
                        .contacts-addresses__item
                            ul
                                li
                                    span Московский офис
                                    a(href="https://yandex.ru/maps/-/CLhBIR89", target="_blank", rel="noreferrer noopener") Москва, Шарикоподшипниковская, д.1 (БЦ «Прогресс Плаза»)
                                li
                                    span Телефон
                                    a(href="tel:+74950551333") +7 (495) 055-13-33
            section.page-contacts-banner-form
                +bannerForm(1)
